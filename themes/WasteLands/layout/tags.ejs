<section class="blog-subpage">
  <a class="blog-back" href="<%= url_for(config.archive_dir || 'archives') %>">← 归档</a>
  <p class="blog-eyebrow">TAGS</p>
  <h1 class="blog-subpage-title">文章标签</h1>
  <div class="blog-tag-cloud"><% site.tags.sort('name').each(tag => { %>
    <a href="<%= url_for(tag.path) %>"><span><%= tag.name %></span><span class="blog-taxonomy-count"><%= tag.length %></span></a>
  <% }); %></div>
  <% if (page.content) { %><div class="blog-reader-body"><%- page.content %></div><% } %>
</section>
