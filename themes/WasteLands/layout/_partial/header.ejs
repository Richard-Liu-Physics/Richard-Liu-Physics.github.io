<header class="blog-header">
  <a class="blog-name blog-brand" href="<%= url_for('/') %>" aria-label="<%= config.author %>，返回首页">
    <img class="blog-site-logo" src="<%= url_for(home.logo || '/images/aki-logo.png') %>" alt="" width="48" height="48">
    <span><%= config.author || config.title %></span>
  </a>
  <button class="blog-menu-toggle" type="button" aria-controls="blog-main-nav" aria-expanded="false">菜单<span aria-hidden="true">＋</span></button>
  <nav id="blog-main-nav" class="blog-nav" aria-label="主导航">
    <a href="<%= url_for('/') %>"<% if (current === 'home') { %> aria-current="page"<% } %>>主页</a>
    <a href="<%= url_for(config.archive_dir || 'archives') %>"<% if (current === 'archive') { %> aria-current="page"<% } %>>归档</a>
    <a href="<%= url_for(aboutPath) %>"<% if (current === 'about') { %> aria-current="page"<% } %>>关于</a>
  </nav>
</header>
